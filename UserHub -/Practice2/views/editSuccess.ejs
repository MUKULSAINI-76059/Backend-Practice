<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body >
      <% if (message) { %>
<div class="fixed inset-0  flex items-center justify-center z-50">
  <div class="bg-white p-6 border border-yellow-500 rounded-xl shadow-xl w-80 text-center">

    <h3 class="text-xl font-bold text-yellow-500 mb-2">
      Success
    </h3>

    <p class="text-gray-600 mb-4">
      <%= message %>
    </p>

    <button
      onclick="window.location.href='/read'"
      class="bg-yellow-500 text-white px-6 py-2 rounded-lg
             hover:bg-yellow-600 transition">
      OK
    </button>

  </div>
</div>
<% } %>
</body>
</html>