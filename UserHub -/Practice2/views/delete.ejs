<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    
    
</head>
<body >
    <div class="main w-full h-screen bg-zinc-900 p-10 text-white">
        <a href="/" class="text-blue-500 inline-block mb-10 hover:text-blue-400 transition-colors duration-400">Go Back To Home</a>
        <form class="w-70 m-auto " action="/delete/<%= user._id %>" method="POST">
                <h1 class="w-89  mt-0 font-serif text-4xl font-semibold mb-9">Delete <%= user.name %></h1>
                <input class="block px-5 py-2 bg-zinc-800 w-4/4 rounded-md outline-none text-zinc-500" type="text" name="Previous" value="<%= user.email %>" readonly>
                <input class="block px-5 py-2 bg-zinc-800 w-4/4 rounded-md outline-none text-zinc-500 mt-5" type="text" name="Previous" value="<%= user.image %>" readonly>
                <input type="submit" class="mt-8 bg-red-600 text-white px-29 py-2 rounded-md hover:scale-105 transition-all duration-300 ease-out" value="Delete">
        </form>
    </div>
    
</body>
</html>

