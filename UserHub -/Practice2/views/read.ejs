<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full min-h-screen bg-zinc-800 p-8 text-white ">
        <div class="nav mb-5">
            <a class="text-blue-500 hover:text-blue-400 transition-colors duration-400" href="/">Back To Home</a> 
           
        </div> <h1 class="font-serif text-3xl font-semibold mb-4">All Users</h1>
        <div class="user flex gap-4 flex-wrap">
           
            <% users.forEach(function(user){ %>
                <div class="user p-4 w-72 rounded-lg bg-zinc-700">
                    <div class="bg-zinc-500 w-full  h-52 rounded-lg overflow-hidden">
                        <img class="h-full w-full object-cover object-center" src="<%= user.image %>" alt="">
                    </div>
                    <h3 class="tracking-tighter text-xl mt-3"><%= user.name %></h3>
                    <h5 class="text-zinc-500"><%= user.email %></h5>
                    <div class="flex gap-3 mt-10 justify-between">
                        <a class="text-zinc-200  hover:text-zinc-400 transition-colors duration-400" href="/edit/<%= user._id %>">Edit user</a>
                        <a class="text-red-500 hover:text-red-700 transition-colors duration-400" href="/delete/<%= user._id %>">Delete user</a>
                    </div>
                </div>
                
            <% }) %>
        
            
            
        </div> 
    </div>
</body>
</html>